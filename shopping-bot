# /장보기 — 장소 선택
# ============================================================
async def cmd_shop(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    keyboard = [
        [InlineKeyboardButton("🛒 마트", callback_data="place|마트")],
        [InlineKeyboardButton("📦 쿠팡", callback_data="place|쿠팡")],
