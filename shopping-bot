def main():
    app = Application.builder().token(BOT_TOKEN).build()

    # /장보기 → 장소 선택 (기타 시 텍스트 입력)
    place_conv = ConversationHandler(
        entry_points=[CommandHandler("shop", cmd_shop)],
        states={
            0: [CallbackQueryHandler(on_place, pattern=r"^place\|")],
            WAITING_CUSTOM_FULL: [MessageHandler(filters.TEXT & ~filters.COMMAND, on_custom_full_text)],
        },
        fallbacks=[CommandHandler("cancel_cmd", on_cancel)],
        per_message=False,
    )
    # 품목 직접 입력
    custom_item_conv = ConversationHandler(
        entry_points=[CallbackQueryHandler(on_custom_item, pattern="^custom_item$")],
        states={
            WAITING_CUSTOM_ITEM: [MessageHandler(filters.TEXT & ~filters.COMMAND, on_custom_item_text)],
        },
        fallbacks=[CommandHandler("cancel_cmd", on_cancel)],
        per_message=False,
    )

    # 완료 → 비고 입력
    list_note_conv = ConversationHandler(
        entry_points=[CallbackQueryHandler(on_finish_pick, pattern="^finish_pick$")],
        states={
            WAITING_LIST_NOTE: [MessageHandler(filters.TEXT & ~filters.COMMAND, on_list_note_text)],
        },
        fallbacks=[CommandHandler("cancel_cmd", on_cancel)],
        per_message=False,
    )
    note_conv = ConversationHandler(
        entry_points=[
            CallbackQueryHandler(on_done, pattern=r"^done\|"),
            CallbackQueryHandler(on_done_all, pattern="^done_all$"),
        ],
        states={
            WAITING_NOTE: [MessageHandler(filters.TEXT & ~filters.COMMAND, on_note_text)],
        },
        fallbacks=[CommandHandler("cancel_cmd", on_cancel)],
        per_message=False,
    )

    app.add_handler(place_conv)
    app.add_handler(custom_item_conv)
    app.add_handler(CallbackQueryHandler(on_finish_pick, pattern="^finish_pick$"))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, on_list_note_text), group=1)
    app.add_handler(CallbackQueryHandler(on_pick, pattern=r"^pick\|"))
    app.add_handler(CallbackQueryHandler(on_pick_all, pattern="^pick_all$"))
    app.add_handler(note_conv)

    app.add_handler(CommandHandler("start", cmd_start))
    app.add_handler(CommandHandler("help", cmd_start))
    app.add_handler(CommandHandler("list", cmd_list))

    app.add_handler(CallbackQueryHandler(on_toggle, pattern=r"^toggle\|"))
    app.add_handler(CallbackQueryHandler(on_noop, pattern="^noop$"))
    app.add_handler(CallbackQueryHandler(on_next_due, pattern="^next_due$"))
    app.add_handler(CallbackQueryHandler(on_due, pattern=r"^due\|"))
    app.add_handler(CallbackQueryHandler(on_cancel, pattern="^cancel$"))

    # 알림 스케줄 (KST 10:00 / 20:00)
    job_queue = app.job_queue
    job_queue.run_daily(send_alert, time=time(10, 0, tzinfo=KST), name="morning_alert")
    job_queue.run_daily(send_alert, time=time(20, 0, tzinfo=KST), name="evening_alert")

    logger.info("Shopping bot started")
    app.run_polling()


if __name__ == "__main__":
    main()
