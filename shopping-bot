async def on_place(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    place = query.data.split("|")[1]

    if place == "기타":
        await query.edit_message_text(
            "장소와 품목을 입력하세요.\n"
            "형식: 장소 - 품목1, 품목2\n"
            "예시: 약국 - 마스크, 밴드"
        )
        return WAITING_CUSTOM_FULL
    ctx.user_data["place"] = place
    ctx.user_data["selected"] = set()
    await show_item_menu(query, ctx)
    return ConversationHandler.END


async def on_custom_full_text(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    """기타 장소 + 품목을 한 번에 입력받기"""
    text = update.message.text.strip()
    if "-" not in text:
        await update.message.reply_text(
            "형식이 안 맞아요. 예: 약국 - 마스크, 밴드\n다시 입력해주세요."
        )
        return WAITING_CUSTOM_FULL

    place_part, items_part = text.split("-", 1)
    place = place_part.strip()
    items = [s.strip() for s in items_part.split(",") if s.strip()]

    if not place or not items:
        await update.message.reply_text(
            "장소나 품목이 비었어요. 다시 입력해주세요."
        )
        return WAITING_CUSTOM_FULL

    ctx.user_data["place"] = place
    ctx.user_data["selected"] = set(items)

    keyboard = [[InlineKeyboardButton(label, callback_data=f"due|{days}")]
                for label, days in DUE_OPTIONS]
    keyboard.append([InlineKeyboardButton("❌ 취소", callback_data="cancel")])
    await update.message.reply_text(
        f"📍 {place}\n📦 {', '.join(items)}\n\n언제까지?",
        reply_markup=InlineKeyboardMarkup(keyboard),
    )
    return ConversationHandler.END

# ============================================================
# 품목 토글 메뉴
# ============================================================
async def show_item_menu(query, ctx):
    place = ctx.user_data["place"]
    selected = ctx.user_data.get("selected", set())
    existing = already_pending_items(place)

    keyboard = []
    items = CATEGORIES.get(place, [])
    for item in items:
        if item in existing:
            label = f"⚪ {item} (등록됨)"
            cb = "noop"
        elif item in selected:
            label = f"✅ {item}"
            cb = f"toggle|{item}"
        else:
            label = f"⬜ {item}"
            cb = f"toggle|{item}"
        keyboard.append([InlineKeyboardButton(label, callback_data=cb)])

    # 사용자가 직접 추가한 품목들도 표시
    for item in selected:
        if item not in items:
            keyboard.append([InlineKeyboardButton(f"✅ {item} (직접입력)", callback_data=f"toggle|{item}")])

    keyboard.append([InlineKeyboardButton("✏️ 품목 직접 입력", callback_data="custom_item")])
    if selected:
        keyboard.append([InlineKeyboardButton(f"➡️ 다음 ({len(selected)}개)", callback_data="next_due")])
    keyboard.append([InlineKeyboardButton("❌ 취소", callback_data="cancel")])

    text = f"📍 {place} — 살 것 선택\n(여러 개 토글 가능)"
    await query.edit_message_text(text, reply_markup=InlineKeyboardMarkup(keyboard))


async def on_toggle(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    item = query.data.split("|")[1]
    selected = ctx.user_data.setdefault("selected", set())
    if item in selected:
        selected.remove(item)
    else:
        selected.add(item)
    await show_item_menu(query, ctx)


async def on_noop(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    await update.callback_query.answer("이미 등록된 항목입니다", show_alert=False)


async def on_custom_item(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    await query.edit_message_text("품목 이름을 입력해주세요. (쉼표로 여러 개 가능: 양배추, 우유)")
    return WAITING_CUSTOM_ITEM


async def on_custom_item_text(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    text = update.message.text.strip()
    items = [s.strip() for s in text.split(",") if s.strip()]
    selected = ctx.user_data.setdefault("selected", set())
    for item in items:
        selected.add(item)

    place = ctx.user_data["place"]
    keyboard = [[InlineKeyboardButton(f"➡️ 다음 ({len(selected)}개)", callback_data="next_due")]]
    keyboard.append([InlineKeyboardButton("✏️ 더 추가", callback_data="custom_item")])
    keyboard.append([InlineKeyboardButton("❌ 취소", callback_data="cancel")])
    await update.message.reply_text(
        f"📍 {place} — 선택됨: {', '.join(sorted(selected))}",
        reply_markup=InlineKeyboardMarkup(keyboard),
    )
    return ConversationHandler.END


# ============================================================
# 마감일 선택
# ============================================================
async def on_next_due(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    selected = ctx.user_data.get("selected", set())
    if not selected:
        await query.answer("선택된 품목이 없습니다", show_alert=True)
        return

    keyboard = [[InlineKeyboardButton(label, callback_data=f"due|{days}")]
                for label, days in DUE_OPTIONS]
    keyboard.append([InlineKeyboardButton("❌ 취소", callback_data="cancel")])
    await query.edit_message_text(
        f"언제까지?\n품목: {', '.join(sorted(selected))}",
        reply_markup=InlineKeyboardMarkup(keyboard),
    )


async def on_due(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    days = int(query.data.split("|")[1])
    due_date = today_kst() + timedelta(days=days)

    place = ctx.user_data["place"]
    selected = ctx.user_data.get("selected", set())

    pending = load_pending()
    for item in selected:
        pending.append({
            "id": make_id(),
            "place": place,
            "item": item,
            "due_date": due_date.isoformat(),
            "postpone_count": 0,
            "completed_at_morning_today": None,
        })
    save_pending(pending)

    ctx.user_data.clear()
    await query.edit_message_text(
        f"✓ 등록 완료\n📍 {place}\n📦 {', '.join(sorted(selected))}\n📅 ~{due_date.isoformat()}"
    )


async def on_cancel(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    ctx.user_data.clear()
    await query.edit_message_text("취소됨")


