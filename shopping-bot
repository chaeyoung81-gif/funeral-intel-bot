# 설정
# ============================================================
load_dotenv()
BOT_TOKEN = os.getenv("BOT_TOKEN")
MY_CHAT_ID = int(os.getenv("MY_CHAT_ID"))
SHEET_ID = os.getenv("SHEET_ID")
KST = ZoneInfo("Asia/Seoul")

BASE_DIR = Path(__file__).parent
CREDS_FILE = BASE_DIR / "credentials.json"
PENDING_FILE = BASE_DIR / "pending.json"

logging.basicConfig(
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    level=logging.INFO,
)
logger = logging.getLogger(__name__)

# 카테고리별 기본 품목
CATEGORIES = {
    "마트": ["콩나물", "두부", "바나나", "팽이버섯", "고구마", "감자"],
    "쿠팡": ["오트밀", "냉동블루베리", "냉동감자", "동태", "냉동망고"],
    "기타": [],
}

# 마감일 옵션
DUE_OPTIONS = [
    ("오늘", 0),
    ("내일", 1),
    ("3일 후", 3),
    ("일주일 후", 7),
]

# ConversationHandler 상태
WAITING_NOTE = 1
WAITING_CUSTOM_ITEM = 2
WAITING_CUSTOM_PLACE = 3
WAITING_CUSTOM_FULL = 4
WAITING_LIST_NOTE = 5
# ============================================================
# 데이터 저장/로드
# ============================================================
def load_pending() -> list:
    if PENDING_FILE.exists():
        return json.loads(PENDING_FILE.read_text(encoding="utf-8"))
    return []


def save_pending(items: list) -> None:
    PENDING_FILE.write_text(
        json.dumps(items, ensure_ascii=False, indent=2),
        encoding="utf-8",
    )


SCOPES = [
    "https://www.googleapis.com/auth/spreadsheets",
    "https://www.googleapis.com/auth/drive",
]

_sheet_cache = None

def get_sheet():
    """구글 시트 객체 반환 (한 번만 인증)"""
    global _sheet_cache
    if _sheet_cache is None:
        creds = Credentials.from_service_account_file(str(CREDS_FILE), scopes=SCOPES)
        client = gspread.authorize(creds)
        _sheet_cache = client.open_by_key(SHEET_ID).worksheet("장보기기록")
    return _sheet_cache


def append_history(row: dict) -> None:
    """완료된 장보기 기록을 구글 시트에 추가"""
    try:
        sheet = get_sheet()
        sheet.append_row([
            row["completed_at"],
            row["place"],
            row["item"],
            row["due_date"],
            row.get("postpone_count", 0),
            row.get("note", ""),
        ])
    except Exception as e:
        logger.error(f"시트 저장 실패: {e}")
        # 실패해도 봇은 죽지 않음

# ============================================================
# 헬퍼
# ============================================================
def today_kst() -> date:
    return datetime.now(KST).date()


def already_pending_items(place: str) -> set:
    return {p["item"] for p in load_pending() if p["place"] == place}


def make_id() -> str:
    return datetime.now(KST).strftime("%Y%m%d%H%M%S%f")


