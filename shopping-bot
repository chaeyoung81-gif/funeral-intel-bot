def build_list_keyboard(pending: list, selected: set) -> InlineKeyboardMarkup:
    """리스트 토글 + 전부 + 완료 버튼"""
    keyboard = []
    for p in pending:
        mark = "✅" if p["id"] in selected else "⬜"
        keyboard.append([InlineKeyboardButton(
            f"{mark} {p['item']} ({p['place']})",
            callback_data=f"pick|{p['id']}",
        )])
    all_ids = {p["id"] for p in pending}
    all_marked = "✅" if selected == all_ids and all_ids else "⬜"
    keyboard.append([InlineKeyboardButton(f"{all_marked} 전부", callback_data="pick_all")])
    if selected:
        keyboard.append([InlineKeyboardButton(
            f"✓ 선택 완료 ({len(selected)}개)",
            callback_data="finish_pick",
        )])
    return InlineKeyboardMarkup(keyboard)


def format_list_text(pending: list) -> str:
    today = today_kst()
    lines = ["📋 장보기 목록\n"]
    by_place = {}
    for p in pending:
        by_place.setdefault(p["place"], []).append(p)
    for place, items in by_place.items():
        lines.append(f"📍 {place}")
        for p in items:
            due = date.fromisoformat(p["due_date"])
            diff = (due - today).days
            if diff < 0:
                icon, when = "🔴", f"{-diff}일 지남"
            elif diff == 0:
                icon, when = "🔴", "오늘까지"
            elif diff == 1:
                icon, when = "🟡", "내일까지"
            else:
                icon, when = "⚪", f"{diff}일 남음"
            lines.append(f"  {icon} {p['item']} — {when}")
        lines.append("")
    return "\n".join(lines)


async def cmd_list(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    pending = load_pending()
    if not pending:
        await update.message.reply_text("등록된 항목이 없습니다.")
        return
    pending.sort(key=lambda p: p["due_date"])
    ctx.chat_data["pick_selected"] = set()
    await update.message.reply_text(
        format_list_text(pending),
        reply_markup=build_list_keyboard(pending, set()),
    )



async def on_pick(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    item_id = query.data.split("|")[1]
    selected = ctx.chat_data.setdefault("pick_selected", set())
    if item_id in selected:
        selected.remove(item_id)
    else:
        selected.add(item_id)
    pending = load_pending()
    pending.sort(key=lambda p: p["due_date"])
    await query.edit_message_reply_markup(
        reply_markup=build_list_keyboard(pending, selected),
    )


async def on_pick_all(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    pending = load_pending()
    pending.sort(key=lambda p: p["due_date"])
    all_ids = {p["id"] for p in pending}
    selected = ctx.chat_data.setdefault("pick_selected", set())
    if selected == all_ids:
        selected.clear()
    else:
        selected.clear()
        selected.update(all_ids)
    await query.edit_message_reply_markup(
        reply_markup=build_list_keyboard(pending, selected),
    )
async def on_finish_pick(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    selected = ctx.chat_data.get("pick_selected", set())
    if not selected:
        await query.answer("선택된 항목이 없습니다", show_alert=True)
        return
    ctx.chat_data["awaiting_list_note"] = True
    ctx.chat_data["completing_ids"] = list(selected)
    pending = load_pending()
    items_str = ", ".join(p["item"] for p in pending if p["id"] in selected)
    await query.edit_message_text(
        f"✓ 완료 처리: {items_str}\n\n비고를 입력하세요. (없으면 -)"
    )

async def on_list_note_text(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    if not ctx.chat_data.get("awaiting_list_note"):
        return  # 이 메시지는 우리 게 아님

    note = update.message.text.strip()
    if note == "-":
        note = ""

    ids = ctx.chat_data.get("completing_ids", [])
    pending = load_pending()
    completed_at = datetime.now(KST).strftime("%Y-%m-%d %H:%M:%S")

    completed_items = []
    remaining = []
    for p in pending:
        if p["id"] in ids:
            append_history({
                "completed_at": completed_at,
                "place": p["place"],
                "item": p["item"],
                "due_date": p["due_date"],
                "postpone_count": p.get("postpone_count", 0),
                "note": note,
            })
            completed_items.append(p["item"])
        else:
            remaining.append(p)
    save_pending(remaining)

    ctx.chat_data.pop("awaiting_list_note", None)
    ctx.chat_data.pop("completing_ids", None)
    ctx.chat_data.pop("pick_selected", None)

    await update.message.reply_text(
        f"✓ 기록 완료: {', '.join(completed_items)}"
        + (f"\n📝 비고: {note}" if note else "")
    )    # 완료 버튼 추가
    keyboard = []
    for p in pending:
        keyboard.append([InlineKeyboardButton(
            f"✓ {p['item']} ({p['place']})",
            callback_data=f"done|{p['id']}",
        )])
    if len(pending) > 1:
        keyboard.append([InlineKeyboardButton("✓ 전부 완료", callback_data="done_all")])

    await update.message.reply_text(
        "\n".join(lines),
        reply_markup=InlineKeyboardMarkup(keyboard),
    )

