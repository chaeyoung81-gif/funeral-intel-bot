# 완료 처리
# ============================================================
async def on_done(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    item_id = query.data.split("|")[1]

    pending = load_pending()
    target = next((p for p in pending if p["id"] == item_id), None)
    if not target:
        await query.edit_message_text("이미 처리됨")
        return ConversationHandler.END

    ctx.user_data["completing_ids"] = [item_id]
    await query.edit_message_text(
        f"✓ {target['item']} 완료!\n비고를 입력하세요. (없으면 -)"
    )
    return WAITING_NOTE


async def on_done_all(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    pending = load_pending()
    today = today_kst().isoformat()
    targets = [p for p in pending if p["due_date"] == today]
    ids = [p["id"] for p in targets]
    if not ids:
        await query.edit_message_text("완료할 항목 없음")
        return ConversationHandler.END

    ctx.user_data["completing_ids"] = ids
    items_str = ", ".join(p["item"] for p in targets)
    await query.edit_message_text(
        f"✓ 전부 완료! ({items_str})\n비고를 입력하세요. (없으면 -)"
    )
    return WAITING_NOTE


