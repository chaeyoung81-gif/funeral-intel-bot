def build_alert_keyboard(items: list) -> InlineKeyboardMarkup:
    keyboard = []
    for p in items:
        keyboard.append([InlineKeyboardButton(
            f"✓ {p['item']} ({p['place']})",
            callback_data=f"done|{p['id']}",
        )])
    if len(items) > 1:
        keyboard.append([InlineKeyboardButton("✓ 전부 완료", callback_data="done_all")])
    return InlineKeyboardMarkup(keyboard)


async def send_alert(ctx: ContextTypes.DEFAULT_TYPE):
    """오늘이 마감일인 항목 알림. 매일 10시 / 20시 실행."""
    pending = load_pending()
    today = today_kst()

    # 마감일 지난 것은 자동으로 오늘로 이월 (정책 2.a)
    changed = False
    for p in pending:
        due = date.fromisoformat(p["due_date"])
        if due < today:
            p["due_date"] = today.isoformat()
            p["postpone_count"] = p.get("postpone_count", 0) + 1
            changed = True
    if changed:
        save_pending(pending)

    # 오늘 마감인 항목만
    due_today = [p for p in pending if p["due_date"] == today.isoformat()]
    if not due_today:
        return

    now = datetime.now(KST).strftime("%H:%M")
    text = f"🔔 [{now}] 오늘 살 것\n\n"
    by_place = {}
    for p in due_today:
        by_place.setdefault(p["place"], []).append(p["item"])
    for place, items in by_place.items():
        text += f"📍 {place}: {', '.join(items)}\n"

    await ctx.bot.send_message(
        chat_id=MY_CHAT_ID,
        text=text,
        reply_markup=build_alert_keyboard(due_today),
    )


